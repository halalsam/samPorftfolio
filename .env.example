# Contact form (/contact) — sent through Resend (https://resend.com).
# API key from the Resend dashboard. Without it the form shows a friendly
# error and nothing is sent.
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=sam@samcode.in
# Sender for the enquiry and the visitor's confirmation. Its domain must be
# verified in Resend.
CONTACT_FROM_EMAIL="samcode.in <hello@samcode.in>"
